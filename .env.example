# Cafe Pilot Environment Configuration
# API keys are kept securely on the server side and never exposed to the client bundle.

# Option 1: GroqCloud (Recommended for sub-second inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Option 2: xAI Grok (Alternative provider)
# GROK_API_KEY=xai_your_xai_key_here
# GROK_MODEL=grok-2-latest
